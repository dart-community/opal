/// Default accent color for interactive controls.
/// @group theme
/// @type Color
$accent: #2563eb !default

/// Computes a fluid font size between two bounds.
/// @param {Number} $min - Minimum size in rem.
/// @param {Number} $max - Maximum size in rem.
/// @return {String} A CSS clamp expression.
@function fluid($min, $max)
  // Clamp keeps typography legible across viewports.
  @return clamp(#{$min}, 2vw + 1rem, #{$max})

/* Theme build: #{$accent} */
.banner
  /*
   * Loud block comments remain in compiled CSS
   * and can span multiple lines.
   */
  color: $accent // Trailing silent comment.
  border-color: /* Match the border to the accent
even in dark mode. */ $accent
  font-size: fluid(1rem, 1.75rem)

/* Indented loud comments can omit the closing delimiter
   and end at the next unindented line.
.after-comment
  /* Keep the link color in sync with the banner.
  color: $accent
  // Silent comments also cover the lines indented beneath them.
    border: 1px solid $accent
  outline-color: $accent
  /*
    An aligned closer still ends the comment.
  */
  background-color: transparent
