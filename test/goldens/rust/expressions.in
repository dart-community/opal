let evens = values.into_iter()
    .filter(move |n| n % 2 == 0)
    .collect::<
        Vec<_>,
    >();

match evens.first().copied() {
    Some(n @ 1..=9) => Some(n),
    _ => None,
}

'outer: for union in sets {
    let mut mask = union as u32;
    while mask > 0 {
        if mask & (1 << bit) != 0 { break 'outer; }
        mask >>= 1;
    }
}

async fn read(rx: &mut Receiver<Vec<u8>>) -> Result<String, Error> {
    loop {
        let Some(bytes) = rx.recv().await else {
            return Err(Error::Closed);
        };
        if bytes.is_empty() { continue; }
        return Ok(String::from_utf8(bytes)?);
    }
}

