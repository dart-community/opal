# Application configuration
^^^^^^^^^^^^^^^^^^^^^^^^^^^
source-text-data-toml-comment-line
title = "Opal"
^^^^^
source-text-data-toml-identifier-property
     ^
     source-text-data-toml-whitespace
      ^
      source-text-data-toml-punctuation-separator
       ^
       source-text-data-toml-whitespace
        ^
        source-text-data-toml-literal-string-quoted-double-literal-string-quoted-double-begin
         ^^^^
         source-text-data-toml-literal-string-quoted-double-literal-string-unquoted
             ^
             source-text-data-toml-literal-string-quoted-double-literal-string-quoted-double-end
enabled = true
^^^^^^^
source-text-data-toml-identifier-property
       ^
       source-text-data-toml-whitespace
        ^
        source-text-data-toml-punctuation-separator
         ^
         source-text-data-toml-whitespace
          ^^^^
          source-text-data-toml-literal-boolean-true

[owner]
^
source-text-data-toml-punctuation
 ^^^^^
 source-text-data-toml-identifier-property
      ^
      source-text-data-toml-punctuation
name = "Example"
^^^^
source-text-data-toml-identifier-property
    ^
    source-text-data-toml-whitespace
     ^
     source-text-data-toml-punctuation-separator
      ^
      source-text-data-toml-whitespace
       ^
       source-text-data-toml-literal-string-quoted-double-literal-string-quoted-double-begin
        ^^^^^^^
        source-text-data-toml-literal-string-quoted-double-literal-string-unquoted
               ^
               source-text-data-toml-literal-string-quoted-double-literal-string-quoted-double-end
joined = 2026-10-24T09:30+08:00
^^^^^^
source-text-data-toml-identifier-property
      ^
      source-text-data-toml-whitespace
       ^
       source-text-data-toml-punctuation-separator
        ^
        source-text-data-toml-whitespace
         ^^^^^^^^^^^^^^^^^^^^^^
         source-text-data-toml-literal-datetime

[server]
^
source-text-data-toml-punctuation
 ^^^^^^
 source-text-data-toml-identifier-property
       ^
       source-text-data-toml-punctuation
ports = [8000, 8001, 8002]
^^^^^
source-text-data-toml-identifier-property
     ^
     source-text-data-toml-whitespace
      ^
      source-text-data-toml-punctuation-separator
       ^
       source-text-data-toml-whitespace
        ^
        source-text-data-toml-literal-collection-array-literal-collection-array-begin
         ^^^^
         source-text-data-toml-literal-collection-array-literal-number-integer
             ^
             source-text-data-toml-literal-collection-array-punctuation-separator
              ^
              source-text-data-toml-literal-collection-array-whitespace
               ^^^^
               source-text-data-toml-literal-collection-array-literal-number-integer
                   ^
                   source-text-data-toml-literal-collection-array-punctuation-separator
                    ^
                    source-text-data-toml-literal-collection-array-whitespace
                     ^^^^
                     source-text-data-toml-literal-collection-array-literal-number-integer
                         ^
                         source-text-data-toml-literal-collection-array-literal-collection-array-end
limits = { requests = 1_000, timeout = 0.5 }
^^^^^^
source-text-data-toml-identifier-property
      ^
      source-text-data-toml-whitespace
       ^
       source-text-data-toml-punctuation-separator
        ^
        source-text-data-toml-whitespace
         ^
         source-text-data-toml-literal-collection-map-literal-collection-map-begin
          ^
          source-text-data-toml-literal-collection-map-whitespace
           ^^^^^^^^
           source-text-data-toml-literal-collection-map-identifier-property
                   ^
                   source-text-data-toml-literal-collection-map-whitespace
                    ^
                    source-text-data-toml-literal-collection-map-punctuation-separator
                     ^
                     source-text-data-toml-literal-collection-map-whitespace
                      ^^^^^
                      source-text-data-toml-literal-collection-map-literal-number-integer
                           ^
                           source-text-data-toml-literal-collection-map-punctuation-separator
                            ^
                            source-text-data-toml-literal-collection-map-whitespace
                             ^^^^^^^
                             source-text-data-toml-literal-collection-map-identifier-property
                                    ^
                                    source-text-data-toml-literal-collection-map-whitespace
                                     ^
                                     source-text-data-toml-literal-collection-map-punctuation-separator
                                      ^
                                      source-text-data-toml-literal-collection-map-whitespace
                                       ^^^
                                       source-text-data-toml-literal-collection-map-literal-number-float
                                          ^
                                          source-text-data-toml-literal-collection-map-whitespace
                                           ^
                                           source-text-data-toml-literal-collection-map-literal-collection-map-end

[[plugins]]
^^
