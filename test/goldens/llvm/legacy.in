%Old = type opaque
@bytes = external global i8*
declare x86_stdcallcc i32 @old(i8* nocapture) readonly
declare x86_mmx @mmx(x86_mmx)
define void @legacy(i32* %p) #0 {
entry:
  %x = load i32, i32* %p
  %cast = bitcast i32* %p to i8*
  %slot = getelementptr i8, i8* %cast, i64 1
  ret void
}
attributes #0 = { argmemonly readnone }
