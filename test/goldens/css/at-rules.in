@charset "UTF-8";
@import url("theme.css") layer(theme) supports(display: grid) screen;
@namespace svg url(http://www.w3.org/2000/svg);

@layer reset, theme;
@layer theme {
  @font-face {
    font-family: "Demo";
    src: url("demo.woff2") format("woff2");
    unicode-range: U+0000-00FF;
  }

  @property --accent {
    syntax: "<color>";
    inherits: false;
    initial-value: #0af;
  }

  @media screen and (width >= 48rem) {
    main { display: grid; }
  }

  @supports selector(:has(> img)) {
    figure:has(> img) { display: block; }
  }

  @container card (inline-size > 30rem) {
    .card { padding: 2rem; }
  }

  @scope (.card) to (.card__body) {
    :scope > header { font-weight: 700; }
  }

  @keyframes fade {
    from { opacity: 0; }
    50% { opacity: 0.5; }
    to { opacity: 1; }
  }

  @page :left { margin: 2cm; }
  @starting-style { .dialog { opacity: 0; } }
  @view-transition { navigation: auto; }
}

@future-rule experimental(foo) {
  future-property: future-value;
}

@media
  screen and (width >= 64rem)
{
  .wide { display: grid; }
}

@media (orientation:landscape) and (min-width:48rem) {
  .compact { display: grid; }
}
