; A small module with a loop and a direct call.
source_filename = "sum.c"
target triple = "aarch64-unknown-linux-gnu"
target datalayout = "e-m:e-i64:64-n32:64-S128"

@total = internal global i32 0, align 4
declare void @report(i32)

define i32 @sum(i32 %limit) #0 {
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %next, %loop ]
  %next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %next, %limit
  br i1 %done, label %exit, label %loop

exit:
  store i32 %next, ptr @total, align 4
  call void @report(i32 %next)
  ret i32 %next
}

attributes #0 = { nounwind memory(readwrite) }

module asm "nop"
uselistorder ptr @total, { 1, 0 }
uselistorder_bb @sum, %loop, { 1, 0 }
