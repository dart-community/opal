^^^^^^
source-text-data-toml-identifier-property
      ^
      source-text-data-toml-whitespace
       ^
       source-text-data-toml-punctuation-separator
        ^
        source-text-data-toml-whitespace
         ^^^^^
         source-text-data-toml-literal-boolean-false
              ^
              source-text-data-toml-whitespace
               ^^^^^^^^^^^^^^^^^
               source-text-data-toml-comment-line
