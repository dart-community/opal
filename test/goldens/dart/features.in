@override
@JsonKey(name: 'id')
@pkg.Annotation.named()
sealed class Shape {}

final class Circle extends Shape with Mixin implements Comparable<Circle> {
  Circle(this.radius) : super();

  factory Circle.unit() => Circle(1);

  final double radius;

  double get area => radius * radius;
  set area(double value) {}

  bool operator ==(Object other) => other is Circle && other.radius == radius;
}

base mixin class Mixin {}
abstract interface class Interface {}

extension type const Id._(int value) implements Object {}
extension StringExtension on String {}

